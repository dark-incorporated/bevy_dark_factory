#!/usr/bin/env bash
# The push gate for loop worker clones (`git config core.hooksPath tools/loop/hooks`). Owner, 2026-10-29.
# A push to main runs the deterministic gate on the commit being pushed and is refused when it fails.
# Measured 2026-10-29: passes that skipped `cargo test --workspace` pushed tests failing 165 of 200 runs.
#
# Clean-merge fast path (owner's session, 2026-10-29). With six workers gating at once, a push refused
# for being behind used to merge main and rerun the whole 40-minute gate, and was often refused again.
# A commit that passes the full gate carries a record in `refs/notes/gated`. A merge commit whose one
# parent carries that record, whose other parent is already on the remote's main (it passed its own
# pusher's gate), and whose tree is exactly what `git merge-tree` makes of the two (no conflict, no hand
# edit) runs clippy over every target, which type-checks every crate and test, instead of the test run.
#
# **The record travels with the commit, not with the clone** (#575). It used to be
# `<git-dir>/gate-passed`, and `git rev-parse --git-dir` inside a worktree is that worktree's own
# administrative directory: the fast path fired on 5 of the 24 clean merges the 2026-11-12..23 log holds,
# because 37 of 39 worktrees had no record at all and a merge of two commits gated on different hosts could
# see neither. A note is pushed with the commit, so a clone that never ran the gate can still read it.
#
# **A tree that linted clean is not linted again** (#574). Clippy's answer depends on the tree, the
# toolchain and RUSTFLAGS, and a refusal at the test step changes none of them: 30 of 161 commits in that
# same log paid clippy twice, 1,149 s in all, the largest repeat 332 s. `gate-clippy` holds one line per
# (tree, toolchain, RUSTFLAGS) that linted clean, and both paths consult it before linting.
set -u
cargo="${LOOP_GATE_CARGO:-cargo}"
# **The gate gets its own target dir, so a push never queues behind an editor** (#633, measured 2026-11-25).
# `~/.zshrc` exports `CARGO_TARGET_DIR=$HOME/.cargo-target-shared/global`, and VS Code's `rust-analyzer` runs
# `cargo check --workspace` against that same dir and holds cargo's exclusive build lock for the whole check.
# A push then waits in `Blocking waiting for file lock on build directory` until the editor goes idle -- measured
# at **over an hour**, across three pushes killed as "hung" before the cause was found. They were not hung.
#
# A caller who set the variable keeps it; only the inherited one is replaced. The cost is a cold build the first
# time this dir fills, which is cheaper than a push that depends on whether a person has their editor open.
# **Keyed on the shared dir's own name, not on "was it set"** -- a shell profile exports it for every command, so
# "set" is true for the caller who chose it and for the one who inherited it alike. Only the well-known shared path
# is diverted; any other `CARGO_TARGET_DIR` is a deliberate choice and is left exactly as given.
case "${CARGO_TARGET_DIR:-}" in
  */.cargo-target-shared/global) export CARGO_TARGET_DIR="${CARGO_TARGET_DIR%/global}-gate" ;;
esac
zero=0000000000000000000000000000000000000000
target="" remote="" code=0
# The pushed refs arrive on stdin once; `git lfs pre-push` below needs them too.
refs=$(cat)
hook_remote="${1:-origin}"
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue
  target="$local_sha" remote="$remote_sha"
  # **A push origin will refuse costs no gate** (owner's session, 2026-10-30). When main has moved past
  # this clone (origin's tip is unknown here, or not an ancestor of the push), the push is refused as
  # non-fast-forward after the hook anyway, so running the 30-40 minute gate first only loses the race
  # again: bmb's w2 lost its log line to this loop for hours (30 commits ahead, a gate timed out at
  # 1800 s, main moved meanwhile). Refuse at once, so the worker merges and pushes again while it is fresh.
  if [ "$remote_sha" != "$zero" ] && { ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null ||
       ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; }; then
    echo "pre-push gate: REFUSED without running the gate: origin's main (${remote_sha:0:9}) is not in this push, so origin would refuse it as non-fast-forward. Run git pull --no-rebase origin main, then push again at once." >&2
    exit 1
  fi
  if [ "$remote_sha" = "$zero" ]; then
    code=1
  elif git diff --name-only "$remote_sha" "$local_sha" | grep -qvE '^docs/|\.md$|\.(gif|mp4|png|jpg|webp)$'; then
    code=1
  fi
done <<<"$refs"
if [ -z "$target" ]; then
  # **A push that is not to main runs no gate, but its LFS objects still go up** (measured 2026-11-21): this early exit used
  # to skip the upload below, so a branch carrying a new changelog clip was refused by GitHub with GH008 (2 unknown LFS
  # objects) and needed a hand-run `git lfs push` first. The refs arrive on stdin once, so they are fed again here.
  printf '%s\n' "$refs" | git lfs pre-push "$@" >&2 || { echo "pre-push: git lfs pre-push failed: the commits' LFS objects (a changelog clip) are not on the server, so GitHub would refuse this push (GH008). Is git-lfs installed (git lfs install)?" >&2; exit 1; }
  exit 0
fi
# Every gate run leaves one line per step in `<git-dir>/gate.log` (time, commit, step, seconds), so how long
# the gate costs each worker is measured, not guessed: pass logs hold only the agent's final message.
# **The shared `.git`, for the same reason #575 moved `gate-passed` to a note** (#673): a worktree's own
# `--git-dir` is `.git/worktrees/<name>`, so this log held the timings of whichever worktree happened to push and the
# next reader saw a fraction of the history.
log="$(git rev-parse --git-common-dir)/gate.log"
note() { printf '%s %s %s\n' "$(date +%FT%T)" "${target:0:9}" "$*" >> "$log"; }
# **A refusal names the tests that failed, keyed by the tree** (#580). Seven of the 93 refused pushes in gate.log to 2026-11-23
# failed a test that passed at the same commit on the next attempt, and a retry re-ran all 5,159 tests to learn what the failing
# names would have said. `<git-dir>/gate-failed/<tree>` holds one nextest test id a line; the next push of that tree runs those
# alone first, at full parallelism, and the whole suite only when one of them fails alone.
# **`--git-common-dir`, not `--git-dir`, for every memo** (#673). A worktree's `--git-dir` is
# `.git/worktrees/<name>`, so a memo written there is invisible to every other worktree and to the main clone: measured
# on big, **1 of 98 worktrees** had the failing-test memo, **1** had the clippy memo, and **none** had the test memo,
# so **17 trees re-ran the suite and 5.0 hours were re-earned**. `--git-common-dir` is the one `.git` they share.
# This is the defect #575 fixed for the merge record and left for these three.
failed_dir="$(git rev-parse --git-common-dir)/gate-failed"
mkdir -p "$failed_dir"
refuse() { note "REFUSED $*"; echo "pre-push gate: REFUSED: $*" >&2; echo "pre-push gate: fix it, or log the item as blocked; never --no-verify." >&2; exit 1; }
timed() { local name=$1 t0 rc; shift; t0=$(date +%s); "$@"; rc=$?; note "$name rc=$rc $(( $(date +%s) - t0 ))s"; return $rc; }
tree=$(git rev-parse "$target^{tree}")
[ "$(git rev-parse HEAD)" = "$target" ] || refuse "push the checked-out commit (HEAD $(git rev-parse --short HEAD), pushing ${target:0:9})"
[ -z "$(git status --porcelain -- crates Cargo.toml Cargo.lock tools)" ] || refuse "uncommitted changes under crates/, Cargo.*, tools/ would be tested instead of the commit; commit or stash them"
# **A clip's file reaches GitHub, not only its pointer** (owner, 2026-11-01). `core.hooksPath` replaces git-lfs's own
# `pre-push`, so a push from this clone sent a clip's pointer to main and kept the file: eight changelog media files were
# missing on the server (GH008, and a fresh checkout failing "smudge filter lfs failed"). Upload the pushed commits' LFS
# objects first, with the refs this hook was given, and refuse the push when that fails.
printf '%s\n' "$refs" | git lfs pre-push "$@" >&2 || refuse "git lfs pre-push failed: the commit's LFS objects (a changelog clip) are not on the server, so the push would leave their pointers without files. Is git-lfs installed (git lfs install)?"
# A merge resolved by hand can leave its conflict markers behind (a10b342 removed six from CHANGELOG.md and ops.rs, 2026-10-29).
markers=$(git grep -nE '^(<<<<<<<|>>>>>>>) ' "$target" -- . ':!*.patch' 2>/dev/null | head -5)
[ -z "$markers" ] || refuse "conflict markers in the commit: ${markers//$'\n'/; }"
timed backlog python3 tools/loop/backlog.py check >/dev/null || refuse "python3 tools/loop/backlog.py check failed"
timed changelog python3 tools/changelog/changelog.py check >/dev/null || refuse "python3 tools/changelog/changelog.py check failed"
timed version python3 tools/loop/version.py check >/dev/null || refuse "python3 tools/loop/version.py check failed: the editor's version or one of its tags is outside the policy (PATCH and MINOR stop at 9; a bump is its own commit and the manifest and Cargo.lock must agree)"
# The editor's integration tests are modules of one binary (`crates/bevy_dark_factory/tests/all.rs`, `autotests = false`):
# a file missing from `all.rs` is never compiled, so its tests never run, and clippy alone (the clean-merge path) cannot see it.
# The exclusivity filter in `.config/nextest.toml` names the tests that measure the host; this fails when a clock-reading
# test is left off it or a named test reads no clock (#577), which is a rule no compile can see.
timed wall-clock-filter python3 tools/loop/wall_clock_filter.py >/dev/null || refuse "python3 tools/loop/wall_clock_filter.py failed: a test that reads a clock or a frame budget is not in .config/nextest.toml's num-cpus filter, or a named test reads none (the message names each)"
all=crates/bevy_dark_factory/tests/all.rs
if [ -f "$all" ]; then
  for f in crates/bevy_dark_factory/tests/*.rs; do
    s=$(basename "$f" .rs)
    [ "$s" = all ] || grep -qx "mod $s;" "$all" || refuse "$f is not a module of the editor's test binary: add \`mod $s;\` to $all (and \`use crate::fixtures;\`, not \`mod fixtures;\`, in the file)"
  done
fi
if [ "$code" = 0 ]; then echo "pre-push gate: docs and media only; backlog and changelog checks passed" >&2; exit 0; fi
# **A version bump needs no test run** (owner, 2026-11-12). A release is `release: <version>`: a manifest's own `version = "x"` line and
# the same line in `Cargo.lock`, nothing else (`tools/loop/version.py check`, above, already holds the policy). It changed no code, but
# the bump forces a rebuild of the whole workspace, so the gate cost ~20 minutes per release commit (two per release) for a result known
# in advance. Only a diff made of nothing but those lines in Cargo manifests qualifies; a dependency version, a feature, a source file,
# or any other line in a manifest runs the full gate.
version_bump_only() {
  local files f
  [ "$remote" != "$zero" ] || return 1
  files=$(git diff --name-only "$remote" "$target") || return 1
  [ -n "$files" ] || return 1
  while read -r f; do
    case "$f" in Cargo.lock | Cargo.toml | crates/*/Cargo.toml) ;; *) return 1 ;; esac
  done <<<"$files"
  # Every added or removed line is `version = "..."` flush left (a dependency's inline `version = ` is not flush left).
  ! git diff -U0 --no-ext-diff "$remote" "$target" | grep -E '^[+-]' | grep -vE '^(\+\+\+|---) ' | grep -qvE '^[+-]version = "[^"]*"$'
}
if version_bump_only; then
  note "version bump only, no tests"
  # **A version bump inherits its parent's tests, and says so in the record** (#625). Every release
  # commit is a bump, and a bump ran no tests -- so without this, `require-gate-record.sh` refused
  # every release tag, in `release-macos.yml`, for the one kind of commit that always accompanies a
  # tag. The note names the parent it inherits from rather than claiming a run of its own.
  # `notes_ref` and `gated()` are declared further down, after the fast paths; name them here so this
  # branch reads the same records and not an unset variable.
  notes_ref=refs/notes/gated
  parent=$(git rev-parse "$target^")
  if git notes --ref "$notes_ref" show "$parent" >/dev/null 2>&1; then
    git notes --ref "$notes_ref" add -f -m "version bump ${target:0:9} inherits the gate of ${parent:0:9}: $(git notes --ref "$notes_ref" show "$parent" | head -1)" "$target" >/dev/null 2>&1
    git push --quiet "$hook_remote" "$notes_ref:$notes_ref" >/dev/null 2>&1 || true
    echo "pre-push gate: a version bump (manifest and Cargo.lock version lines only); it inherits ${parent:0:9}'s gate record, no test run" >&2
  else
    echo "pre-push gate: a version bump whose parent ${parent:0:9} has no gate record; the version policy check passed, no test run" >&2
  fi
  exit 0
fi
clippy_file="$(git rev-parse --git-common-dir)/gate-clippy"
notes_ref=refs/notes/gated
# A clone that has never gated anything still reads the records, because they were pushed with the commits. The merge,
# not a forced refspec: this clone's own notes are records too, and overwriting the ref would drop the ones written here
# before they were pushed (measured: a fresh fetch clobbered two local notes and the fast path then refused a clean merge).
git fetch --quiet "$hook_remote" "$notes_ref" >/dev/null 2>&1 &&
  git notes --ref "$notes_ref" merge FETCH_HEAD >/dev/null 2>&1 || true
gated() { git notes --ref "$notes_ref" show "$1" >/dev/null 2>&1; }
# Written where the gate actually runs, so the proof is in the commit rather than in the clone that happened to gate it.
record_gated() {
  git notes --ref "$notes_ref" add -f -m "gated on $(uname -n) $(date +%FT%T): clippy over every target, nextest and doctests passed" "$1" >/dev/null 2>&1 ||
    { echo "pre-push gate: WARNING: could not write the $notes_ref note for ${1:0:9}" >&2; return 0; }
  git push --quiet "$hook_remote" "$notes_ref:$notes_ref" >/dev/null 2>&1 ||
    echo "pre-push gate: WARNING: the record for ${1:0:9} did not reach $hook_remote; a clone without it runs the full gate" >&2
}
# Clippy's answer is a fact about (tree, toolchain, RUSTFLAGS). Any source edit, a manifest change or a toolchain bump
# moves the key; a refusal at the test step moves none of them, which is what makes remembering it free of weakening.
clippy_key() { printf '%s\n' "$(git rev-parse "$1^{tree}") rustc $(rustc -vV | tr '\n' ' ') RUSTFLAGS ${RUSTFLAGS:-}"; }
clippy_ok() { [ -f "$clippy_file" ] && grep -qxF "$(clippy_key "$1")" "$clippy_file"; }
record_clippy() { clippy_key "$1" >> "$clippy_file"; }
clean_merge_of_main() {
  local parents p1 p2 tree
  parents=$(git rev-list --parents -n 1 "$target")
  set -- $parents
  [ $# -eq 3 ] || return 1
  p1=$2 p2=$3
  { gated "$p1" && git merge-base --is-ancestor "$p2" "$remote"; } ||
    { gated "$p2" && git merge-base --is-ancestor "$p1" "$remote"; } || return 1
  tree=$(git merge-tree --write-tree "$p1" "$p2" 2>/dev/null) || return 1
  [ "$tree" = "$(git rev-parse "$target^{tree}")" ]
}
# Git opens the connection before this hook runs, and GitHub drops it while a 30-minute gate runs
# ("Connection to github.com closed by remote host", bevy_emerge_loop, 2026-10-29): the gate passed,
# the push did not. Pushing the same commit again needs no second gate.
if gated "$target"; then note "already gated, pushing again"; echo "pre-push gate: ${target:0:9} already passed the gate in this clone; pushing it again" >&2; exit 0; fi
start=$(date +%s)
if clean_merge_of_main; then
  echo "pre-push gate: ${target:0:9} is a clean merge of main into a commit that carries a gate record; clippy over every target only" >&2
  if clippy_ok "$target"; then
    note "clippy-merge cached 0s (this tree, toolchain and RUSTFLAGS already linted clean)"
  else
    timed clippy-merge $cargo clippy --workspace --all-targets -q -- -D warnings || refuse "cargo clippy --workspace --all-targets -- -D warnings failed on the merge"
    record_clippy "$target"
  fi
  # **Rustdoc runs on the merge path too** (#549): clippy type-checks a merge and cannot see a doc comment, so a merge that
  # joins one commit's rename to another's citation is exactly what nothing else in this path would catch. It runs whether clippy was
  # cached or not: a cached lint says nothing about the doc comments.
  timed rustdoc-merge env RUSTDOCFLAGS="-D warnings" $cargo doc --workspace --no-deps -q || refuse "RUSTDOCFLAGS=\"-D warnings\" cargo doc --workspace --no-deps failed on the merge (a doc comment links a private item or names nothing that exists)"
else
  echo "pre-push gate: clippy and the test suite on ${target:0:9}; this takes minutes, so give git push a timeout of 1800 s or more" >&2
  if clippy_ok "$target"; then
    note "clippy cached 0s (a previous attempt at this tree linted clean)"
  else
    timed clippy $cargo clippy --workspace --all-targets -q -- -D warnings || refuse "cargo clippy --workspace --all-targets -- -D warnings failed"
    record_clippy "$target"
  fi
  # **nextest runs test binaries in parallel; cargo test runs them serially.** Measured on big at one
  # commit, 2,810 tests: `cargo test --workspace` 451 s, bare `cargo nextest run --workspace` 43 s.
  # **This step is not that 43 s.** It is the step as the gate runs it — clippy already done, on a warm
  # target, `--no-fail-fast` — and big's own `bevy_emerge_loop/.git/gate.log` records it at 154-181 s
  # over the 169 runs to 2026-11-03. Quoting the bare number here told every pass its gate was four
  # times cheaper than it is (corrected 2026-11-04). nextest does NOT run doctests, so `--doc` is its
  # own step below.
  test_runner="${LOOP_GATE_TEST:-}"
  if [ -z "$test_runner" ]; then
    if command -v cargo-nextest >/dev/null 2>&1 || cargo nextest --version >/dev/null 2>&1; then
      test_runner=nextest
    else
      test_runner=cargo
    fi
  fi
  # **The failing tests of one run, as nextest names them**: `FAIL [ 1.84s] (3/10) bevy_dark_factory::editor path::to::test`.
  run_alone() {
    # One nextest test id a line on stdin, run together at full parallelism: nonzero when any of them fails.
    local expr="" id ids=()
    while read -r id; do
      [ -n "$id" ] || continue
      ids+=("$id")
      expr="${expr:+$expr | }test(${id})"
    done
    [ -n "$expr" ] || return 0
    if [ "$test_runner" = nextest ]; then
      $cargo nextest run --workspace --no-fail-fast --test-threads num-cpus -E "$expr"
    else
      # `cargo test` takes one filter and no filterset; its filter is a substring of the test's path, which is the id.
      local one
      for one in "${ids[@]}"; do
        $cargo test --workspace --no-fail-fast "$one" || return 1
      done
    fi
  }
  if [ -s "$failed_dir/$tree" ]; then
    # **This tree has already been through the whole suite and only these tests failed** (#580): run them alone rather than
    # spend a full gate learning the same names again. Full parallelism, because a test that needs a quiet host to pass is the
    # flake this is here to name.
    echo "pre-push gate: this tree failed $(wc -l < "$failed_dir/$tree") test(s) before; running those alone first" >&2
    if run_alone < "$failed_dir/$tree"; then
      echo "pre-push gate: they pass alone at this tree, so the earlier failure was the host and not the tree; the rest of the suite already passed here" >&2
      note "the $(wc -l < "$failed_dir/$tree") named test(s) pass alone at this tree"
      # The record survives the push it unblocked, so a tree tested a third time still runs only these first.
      rm -f "$failed_dir/$tree.alone"
      timed doc $cargo test --workspace --doc -q || refuse "cargo test --workspace --doc failed (doctests are not run by nextest)"
    else
      # **The named tests failed alone, so this is a real failure and the push stays refused.** If it was already the second
      # attempt at this tree the record says so, and the message says which of the two attempts it was.
      if [ -s "$failed_dir/$tree.alone" ]; then
        refuse "these tests failed alone at this tree twice: $(tr '\n' ' ' < "$failed_dir/$tree") — a real failure, not the host"
      fi
      cp "$failed_dir/$tree" "$failed_dir/$tree.alone"
      refuse "these tests failed alone at this tree: $(tr '\n' ' ' < "$failed_dir/$tree") — a real failure, not the host; a second attempt at this tree that fails alone again is refused without running the suite"
    fi
  elif [ "$test_runner" = nextest ]; then
    out=$(mktemp)
    timed test $cargo nextest run --workspace --no-fail-fast 2>&1 | tee "$out"
    rc=${PIPESTATUS[0]}
    # **Keep the test log, do not delete it** (#625). `nextest`'s own `Summary [N s]` line and cargo's
    # `Compiling`/`Finished` lines are the only record of how much of this step was *compiling* and how much was
    # *running*, and the `rm -f "$out"` below threw them away — so a gate's 1,300 s test step could not be split
    # into two numbers, and every attempt to make the gate faster was guessing. One file per tree, beside
    # `gate.log`, so the next reader can measure instead of assume.
    keep="$(git rev-parse --git-common-dir)/gate-tests/$(printf '%s' "$tree" | cut -c1-9).log"
    mkdir -p "$(dirname "$keep")" && cp "$out" "$keep" 2>/dev/null || true
    if [ "$rc" != 0 ]; then
      sed -n 's/.*FAIL \[[^]]*\] ([^)]*) //p' "$out" | sort -u > "$failed_dir/$tree"
      cat "$failed_dir/$tree"
      rm -f "$out"
      refuse "cargo nextest run --workspace failed (the failing tests are named above and kept against tree ${tree:0:9})"
    fi
    rm -f "$out"
    timed doc $cargo test --workspace --doc -q || refuse "cargo test --workspace --doc failed (doctests are not run by nextest)"
  else
    timed test $cargo test --workspace -q --no-fail-fast || refuse "cargo test --workspace failed (the failing tests are named above)"
  fi
  # **Rustdoc reads a doc comment the way a reader does, and nothing else in the gate does** (measured on big,
  # 2026-11-23, at f386fdff: `RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps` fails in 42 s on a warm
  # target, 4% of the gate's 1,054 s). Every error it reports is a doc comment that is wrong about what a reader
  # can reach or what exists — three of the 2026-11-23 review's six stale-comment clusters (#543's broken links,
  # #544's version citations, #548's renamed symbols) are exactly this. Clippy is happy with all of them.
  timed rustdoc env RUSTDOCFLAGS="-D warnings" $cargo doc --workspace --no-deps -q || refuse "RUSTDOCFLAGS=\"-D warnings\" cargo doc --workspace --no-deps failed (a doc comment links a private item, an item that does not exist, or a malformed link)"
fi
record_gated "$target"
note "passed $(( $(date +%s) - start ))s"
echo "pre-push gate: passed in $(( $(date +%s) - start ))s" >&2
