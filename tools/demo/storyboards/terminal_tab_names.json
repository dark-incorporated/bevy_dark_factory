    {"at": 10.0, "click_label": "+", "within": [950, 395, 1088, 440], "caption": "four, five, six tabs"},
    {"at": 11.0, "click_label": "+", "within": [950, 395, 1088, 440]},
    {"at": 12.0, "click_label": "+", "within": [950, 395, 1088, 440]},
